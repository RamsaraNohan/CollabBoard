{
  "name": "collabboard-assignment-02",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:mock": "vite --mode mock",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "concurrently -k -n API,WEB -c cyan,blue \"npm:dev:server\" \"npm:dev:client\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:server": "npm --prefix server run test:run",
    "test:all": "npm run test:run && npm run test:server"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^29.1.1",
    "concurrently": "^9.2.1",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
